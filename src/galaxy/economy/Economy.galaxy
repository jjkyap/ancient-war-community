// Validation: uncompiled. Pure affordability predicate; does not mutate balances.
bool AWCanAfford(int gold, int wood, int goldCost, int woodCost) {
    return gold >= 0 && wood >= 0 && goldCost >= 0 && woodCost >= 0
        && gold >= goldCost && wood >= woodCost;
}
